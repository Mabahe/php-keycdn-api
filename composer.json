{
    "name": "mabahe/keycdn-api",
    "description": "PHP Library for the KeyCDN API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.keycdn.com",
    "support": {
        "email": "support@keycdn.com",
        "source": "https://github.com/mabahe/php-keycdn-api"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "php-http/discovery": "^1.18",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.4"
    },
    "suggest": {
        "ext-curl": "Needed for the built-in transport; not required when a PSR-18 client is passed via the \"httpclient\" option",
        "psr/http-client-implementation": "Any PSR-18 client, to be used via the \"httpclient\" option",
        "psr/http-factory-implementation": "Any PSR-17 factories, used with a PSR-18 client (auto-discovered)"
    },
    "autoload": {
        "psr-4": {
            "KeyCDN\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeyCDN\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
