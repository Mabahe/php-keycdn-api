{
    "name": "mabahe/keycdn-api",
    "description": "PHP Library for the KeyCDN API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.keycdn.com",
    "support": {
        "email": "support@keycdn.com",
        "source": "http://www.github.com/keycdn/php-keycdn-api"
    },
    "require": {
        "php": ">=7.4.0",
        "psr/http-client": "^1.0",
        "php-http/discovery": "^1.18",
        "ext-curl": "*",
        "psr/http-client-implementation": "*",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
      "symfony/http-client": "^5.4 || ^6.4 || ^7.4",
      "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "KeyCDN\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
